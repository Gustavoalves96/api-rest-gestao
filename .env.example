# Copie para .env e ajuste os valores. Nunca faça commit do .env.

# Conexão assíncrona com o PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gestao

# Segurança / JWT
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens do frontend, separadas por vírgula. Em produção, use o domínio da Vercel.
CORS_ORIGINS=http://localhost:3000

# Gateway de pagamento: "fake" (em memória, para dev/testes) ou "http" (REST genérico)
PAYMENT_GATEWAY=fake
GATEWAY_BASE_URL=http://localhost:9000
GATEWAY_API_KEY=
WEBHOOK_SECRET=troque-por-um-segredo-de-webhook
COBRANCA_EXPIRA_MINUTOS=30
